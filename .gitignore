# ==========================================
# Общие правила для всех проектов
# ==========================================
# Переменные окружения (секреты не должны попадать в Git)
.env
.env.local
.env.*.local

# Логи
*.log
#logs/

# Системные файлы ОС
.DS_Store
Thumbs.db

# Файлы редакторов и IDE
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Go (актуально для front-end и будущих Go-сервисов)
# ==========================================
# Скомпилированные бинарники
*.exe
*.exe~
*.dll
*.so
*.dylib
# Бинарники без расширения (частая проблема в Go)
front-end/cmd/web/web
# (можно добавить аналогичные строки для будущих сервисов, например: back-end/cmd/api/api)

# Тестовые файлы и покрытие
*.test
*.out

# Папка с зависимостями (если решите вендорить)
vendor/

# ==========================================
# Node.js / JavaScript (на случай, если добавите фронт на React/Vue)
# ==========================================
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Python (на случай, если добавите Python-микросервис)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# ==========================================
# Docker (если будете использовать)
# ==========================================
# (обычно docker-compose.yml и Dockerfile коммитятся, так что тут пусто)

info.txt

**/db-data/